enum PostVisibility {
    PUBLIC
    PRIVATE
}

model Post {
    id           BigInt         @id @default(autoincrement())
    publicId     String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid // exposed in API/URLs
    userId       String
    imageUrl     String?
    caption      String?
    visibility   PostVisibility @default(PUBLIC)
    likeCount    Int            @default(0)
    commentCount Int            @default(0)

    createdAt DateTime  @default(now()) @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @db.Timestamptz(6)
    deletedAt DateTime? @db.Timestamptz(6)

    // Relations
    user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    comments Comment[]
    likes    PostLike[]

    @@index([visibility, deletedAt, createdAt(desc), id(desc)])
    @@index([userId, deletedAt, createdAt(desc)])
}

model PostLike {
    postId    BigInt
    userId    String
    createdAt DateTime @default(now()) @db.Timestamptz(6)

    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([postId, userId])
    @@index([postId, createdAt(desc)])
    @@index([userId, createdAt(desc)])
}

model Comment {
    id       BigInt  @id @default(autoincrement())
    publicId String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    postId   BigInt
    userId   String
    parentId BigInt?
    rootId   BigInt?
    content  String

    likeCount  Int @default(0)
    replyCount Int @default(0)

    createdAt DateTime  @default(now()) @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @db.Timestamptz(6)
    deletedAt DateTime? @db.Timestamptz(6)

    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies Comment[] @relation("CommentReplies")

    likes CommentLike[]

    @@index([postId, parentId, deletedAt, id(desc)])
    @@index([rootId, deletedAt, id(desc)])
    @@index([parentId, deletedAt, id(desc)])
    @@index([userId, deletedAt, id(desc)])
}

model CommentLike {
    commentId BigInt
    userId    String
    createdAt DateTime @default(now()) @db.Timestamptz(6)

    comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([commentId, userId])
    @@index([commentId, createdAt(desc)])
    @@index([userId, createdAt(desc)])
}
