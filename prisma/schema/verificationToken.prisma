model VerificationToken {
    id         String   @id @default(cuid())
    identifier String // email address
    token      String
    type       OTPType
    expiresAt  DateTime
    usedAt     DateTime?
    attempts   Int      @default(0)
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([identifier, type])
    @@index([userId])
}

enum OTPType {
    EMAIL_VERIFY
    PASSWORD_RESET
}
