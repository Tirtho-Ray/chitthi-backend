NODE_ENV=development
PORT=9000
ALLOWED_ORIGINS=http://localhost:5173

# Security
BCRYPT_SALT_ROUNDS=12

# Database
DATABASE_URL=

# JWT Access
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7

# Standard JWT Claims
JWT_ISSUER=willgus_auth_service
JWT_AUDIENCE=willgus_web_client


# Auth Configuration
MAX_SESSIONS=5
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=12



REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECTION_URL=

# Email Configuration
EMAIL_PROVIDER=GMAIL # Options: GMAIL, SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trax <no-reply@yourapp.com>"
EMAIL_MAX_PER_MINUTE=14 # rate limit 

# AWS Credentials (Required for SES or S3)
AWS_REGION=us-east-1
AWS_REGION_FACE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# super admin  
ADMIN_EMAIL=
ADMIN_PASSWORD=



# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Agora Configuration
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY=3600
